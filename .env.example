# Optional base URL for a separate deployed AI 360 API. Leave blank to use this site's /api/ai function.
VITE_AI_API_URL=

# Public Groq API base URL used to prefill Groq settings. This is not an API key.
VITE_GROQ_API_URL=https://api.groq.com/openai/v1

# Keep provider credentials server-side:
# wrangler secret put GROQ_API_KEY
# wrangler secret put OPENROUTER_API_KEY
